# ================== BAZA ==================
# Neon connection string'ni shu yerga qo'ying (postgresql:// bilan boshlanadi)
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# ================== TELEGRAM ==================
BOT_TOKEN="123456:AA..."
BOT_USERNAME="K_Beauty_Store_Optom_bot"

# Mini App havolasi.
# Hostingda (Render) DOIMIY havola bo'lishi shart:
#   WEBAPP_URL="https://kbeauty-miniapp.vercel.app"
# Kompyuterda cloudflared/ngrok havolasini qo'yasiz. Ular vaqtinchalik:
# kompyuter o'chsa o'ladi, shuning uchun hostingda ishlatilmaydi (kod ularni
# o'zi rad etib, doimiy havolaga o'tadi).
WEBAPP_URL="http://localhost:5173"

# ================== SERVER ==================
PORT=4000
API_BASE_URL="http://localhost:4000"

# ================== ADMIN PANEL ==================
# Kamida 8 ta belgi. Zaxira qiymat YO'Q — bo'sh qoldirsangiz server ishga tushmaydi.
ADMIN_PASSWORD="bu-yerga-kuchli-parol-yozing"

# Localhost'da brauzerdan test qilish uchun true. Ishga tushirilganda false qiling.
ALLOW_INSECURE_AUTH=true

# ================== KEEP-ALIVE ==================
# Render'ning bepul serveri 15 daqiqa tinchlikdan keyin uxlaydi va bot o'chadi.
# Server o'ziga-o'zi so'rov yuborib uyg'oq turadi. Render bu manzilni
# (RENDER_EXTERNAL_URL) o'zi beradi — qo'lda yozish shart emas.
# Pullik tarifga o'tsangiz o'chirib qo'ying: KEEP_ALIVE=false
# KEEP_ALIVE=true
# KEEP_ALIVE_URL="https://k-beauty-0rv9.onrender.com"
